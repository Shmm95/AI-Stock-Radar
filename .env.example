# Copy this file to .env and fill in real values. Never commit .env.
# .env is already gitignored — see .gitignore.

# Used by src/agents/analyst_agent.py
OPENAI_API_KEY=

# Used by src/data/alpaca_market_data.py (read-only market data client).
# Get these from an Alpaca PAPER trading account:
# https://app.alpaca.markets/paper/dashboard/overview -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Used by src/notify/telegram_notifier.py (owner notifications from
# run_daily_decision.py / run_crypto_stop_monitor.py). Optional: if
# left empty, notifications are silently skipped, trading is unaffected.
# Create a bot with @BotFather, then message your bot once and read
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
